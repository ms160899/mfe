# Nginx Configuration for MFE Application
# Save as /etc/nginx/sites-available/app.yourorg.com

upstream mfe_app {
    server localhost:3000;
}

# Redirect HTTP to HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name app.yourorg.com;
    
    return 301 https://$server_name$request_uri;
}

# HTTPS Server
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name app.yourorg.com;

    # SSL Certificates
    ssl_certificate /etc/letsencrypt/live/app.yourorg.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.yourorg.com/privkey.pem;
    
    # SSL Configuration
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:50m;

    # Security Headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    
    # CSP Header
    add_header Content-Security-Policy "
        default-src 'self';
        script-src 'self' 'wasm-unsafe-eval';
        style-src 'self' 'unsafe-inline';
        frame-ancestors https://client1.com https://client2.com;
        connect-src 'self' https://api.yourorg.com;
        object-src 'none';
        base-uri 'self';
        form-action 'self'
    " always;

    root /var/www/mfe-app/dist/browser;
    index index.html;

    # Federation manifest — short cache, must revalidate
    location ~ ^/mfe/[^/]+/remoteEntry\.json$ {
        add_header Cache-Control "public, max-age=300, must-revalidate";
        add_header Content-Type "application/json";
    }

    # Federation chunks — content-hashed, immutable (1 year cache)
    location ~ ^/mfe/.*\.js$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header Content-Type "application/javascript";
    }

    # Embed SDK — short-medium cache (1 hour)
    location = /embed-sdk.js {
        add_header Cache-Control "public, max-age=3600";
        add_header Content-Type "application/javascript";
    }

    # Static assets (images, fonts, etc.) — long cache
    location ~ ^/(assets|fonts|images)/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # App shell (index.html) — never cache
    location = /index.html {
        add_header Cache-Control "no-cache";
        add_header Content-Type "text/html; charset=utf-8";
    }

    # SPA fallback — must come after /mfe/ rules
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Deny access to hidden files
    location ~ /\. {
        deny all;
    }

    # Deny access to sensitive files
    location ~ ~$ {
        deny all;
    }

    # Logging
    access_log /var/log/nginx/app.yourorg.com-access.log;
    error_log /var/log/nginx/app.yourorg.com-error.log;
}
