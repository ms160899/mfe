{
  "routes": [
    {
      "route": "/remoteEntry.json",
      "serve": "/remoteEntry.json",
      "statusCode": 200,
      "headers": {
        "Content-Type": "application/json"
      }
    },
    {
      "route": "/*.js",
      "serve": "/*.js",
      "statusCode": 200,
      "headers": {
        "Content-Type": "application/javascript",
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/*.css",
      "serve": "/*.css",
      "statusCode": 200,
      "headers": {
        "Content-Type": "text/css",
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/*",
      "serve": "/index.html",
      "statusCode": 200
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/remoteEntry.json", "*.json", "*.js", "*.css", "*.svg", "*.png", "*.jpg", "*.jpeg", "*.gif", "*.woff", "*.woff2"]
  },
  "mimeTypes": {
    ".json": "application/json",
    ".js": "application/javascript",
    ".wasm": "application/wasm"
  }
}
